{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",

  "control-center-margin-top": 12,
  "control-center-margin-right": 12,
  "control-center-margin-bottom": 12,
  "control-center-width": 380,
  "control-center-height": -1,
  
  "notification-icon-size": 64,
  "notification-body-image-height": 96,
  "notification-body-image-width": 200,

  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,

  "fit-to-screen": false,
  "notification-window-width": 340,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": [
    "volume",
    "backlight",
    "mpris",
    "title",
    "notifications"
  ],

  "widget-config": {
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃟"
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 12,
      "blur": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
